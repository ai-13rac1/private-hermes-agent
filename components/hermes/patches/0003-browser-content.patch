+export function mountBrowserPreviewFrame(options: BrowserPreviewFrameOptions): () => void {
+  let disposed = false
+  const fallback = document.createElement('div')
+  fallback.className = 'block rounded border border-dashed p-4 text-sm'
+  fallback.textContent = 'Checking deployment content policy…'
+  options.host.appendChild(fallback)
+  let latestUrl = options.url
+  const pendingNavigation: PreviewNavigationSurface = {loadURL: async next => { latestUrl = next }}
+  options.navigationRef.current = pendingNavigation
+  let cleanup = () => {
+    if (options.navigationRef.current === pendingNavigation) options.navigationRef.current = null
+    fallback.remove()
+  }
+  void browserContentMode().then(mode => {
+    if (disposed) return
+    if (mode === 'browser_native') {
+      fallback.remove()
+      cleanup = mountNativeBrowserPreviewFrame({...options, url: latestUrl})
+      return
+    }
+    const show = (raw: string) => {
+      fallback.replaceChildren(document.createTextNode('Web previews are unavailable in private modes. '))
+      try {
+        const url = new URL(raw)
+        if (url.protocol === 'http:' || url.protocol === 'https:') {
+          const link = document.createElement('a')
+          link.href = url.href; link.target = '_blank'; link.rel = 'noopener noreferrer'
+          link.textContent = 'Open externally (uses your browser connection): ' + url.origin
+          fallback.appendChild(link)
+        }
+      } catch { /* An invalid URL has no external navigation action. */ }
+      options.setCurrentUrl(raw); options.setLoading(false)
+    }
+    show(latestUrl)
+    const navigation: PreviewNavigationSurface = {loadURL: async next => show(next), reload: () => show(options.url)}
+    options.navigationRef.current = navigation
+    cleanup = () => {
+      if (options.navigationRef.current === navigation) options.navigationRef.current = null
+      fallback.remove()
+    }
+  })
+  return () => { disposed = true; cleanup() }
+}
